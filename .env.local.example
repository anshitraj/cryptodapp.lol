# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Your own wallets — payments go straight here, verified on-chain server-side.
# No payment processor involved. Same EVM address covers Ethereum/BSC/Polygon/Base.
NEXT_PUBLIC_TREASURY_SOLANA_ADDRESS=
NEXT_PUBLIC_TREASURY_EVM_ADDRESS=

# Solana. NEXT_PUBLIC_ is the one the browser uses to send payments — it must
# be an endpoint that serves browsers (api.mainnet-beta.solana.com does NOT,
# it 403s them). publicnode works keyless; swap in Helius/QuickNode for real
# traffic. SOLANA_RPC_URL is server-only (payment verification), so a paid
# key-bearing endpoint can go there without exposing it to the browser.
NEXT_PUBLIC_SOLANA_RPC_URL=https://solana-rpc.publicnode.com
SOLANA_RPC_URL=https://solana-rpc.publicnode.com
ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com
BSC_RPC_URL=https://bsc-dataseed.binance.org
POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com
BASE_RPC_URL=https://mainnet.base.org

# WalletConnect project id (free) — cloud.reown.com → create project → copy
# the id. Without this, EVM payment only works via a browser wallet
# extension; with it, RainbowKit's modal also offers WalletConnect, which is
# what makes paying from a phone (no extension) actually work.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Umami (open source, umami.is) — self-host or use the free cloud tier at
# cloud.umami.is, create a website there, paste its Website ID below.
# Leave blank to skip loading the analytics script entirely.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js

NEXT_PUBLIC_SITE_URL=http://localhost:3000
